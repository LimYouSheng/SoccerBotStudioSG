          "queryType": "traceql",
          "query": "{ resource.service.name = \"soccerbot-dev\" && span.soccerbot.event = \"checkout_trace\" && span.soccerbot.retention = \"sampled_success\" } | avg_over_time(span.soccerbot.d1_count)",
          "metricsQueryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
