{
  "name": "soccerbotstudiosg",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "preview": "node scripts/serve-export.mjs",
    "typecheck": "node scripts/reset-next-types.mjs && next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:source": "node scripts/check-source.mjs",
    "check:tooling": "node --test scripts/*.test.mjs",
    "verify": "node scripts/verify.mjs all",
    "check:installer": "python3 scripts/guarded-update.test.py --verbose && python3 scripts/local-installer.test.py --verbose",
    "format": "prettier --write src scripts/*.mjs tests *.ts *.mjs *.json docs/*.md README.md AGENTS.md .github/workflows/*.yml",
    "check:policy": "node scripts/check-policy.mjs",
    "verify:code": "node scripts/verify.mjs code",
    "verify:browser": "node scripts/verify.mjs browser",
    "format:check": "prettier --check src scripts/*.mjs tests *.ts *.mjs package.json package-lock.json tsconfig.json README.md AGENTS.md docs/*.md .github/workflows/*.yml"
  },
  "dependencies": {
    "jspdf": "4.2.1",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "css-tree": "3.2.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "jsdom": "30.1.1",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  },
  "type": "module",
  "packageManager": "npm@11.9.0"
}
