{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "soccerbot-dev",
  "account_id": "517f4f85eb8f982b483dbc05b797fd88",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"],
  },
  "d1_databases": [
    {
      "binding": "STATE",
      "database_name": "soccerbot-dev-state",
      "database_id": "297a991b-70a7-438d-a0e3-39fa3a7f2cee",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "COORDINATOR", "class_name": "SoccerBotAccountCoordinator" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SoccerBotAccountCoordinator"] },
  ],
  "vars": {
    "DEPLOYMENT_ACCOUNT_ID": "517f4f85eb8f982b483dbc05b797fd88",
    "STATE_DATABASE_ID": "297a991b-70a7-438d-a0e3-39fa3a7f2cee",
    "APP_ORIGIN": "https://soccerbot-dev.limyousheng-94.workers.dev",
    "ENVIRONMENT": "developer",
    "PROVIDER_ACCESS": "disabled",
    "SOURCE_REVISION": "unpublished",
    "ACCESS_LIFETIME_MS": "1800000",
    "OBSERVATION_MAX_AGE_MS": "15000",
    "POLL_INTERVAL_MS": "5000",
    "CHECKING_DEADLINE_MS": "600000",
    "CAMPAIGN_ID": "developer-20261008",
    "CAMPAIGN_END_MS": "0",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false },
  },
}
